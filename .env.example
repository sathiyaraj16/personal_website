# NEXA Supabase Configuration
# Replace with your actual project URL and anon public key from the Supabase dashboard (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth 2.0 Configuration (Phase 4: Google Drive & Google Photos)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web application)
# Authorised JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
